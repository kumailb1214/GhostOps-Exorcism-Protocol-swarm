# Copy to ghostops/.env — never commit the real file.
TEAM_HANDLE="team-XX"

# You.com — grounding (X-API-Key header). Sign up at https://you.com/home
YDC_API_KEY=""

# Parasail — inference + embeddings (OpenAI-compatible at https://api.parasail.io/v1)
PARASAIL_API_KEY=""
PARASAIL_MODEL="parasail-glm-53-flash"
PARASAIL_EMBED_MODEL="parasail-bge-m3"

# One — real actions (Discord). Create key at app.withone.ai/settings/api-keys.
# ONE_MCP_URL is the remote MCP endpoint from the event skill (hackathon.withone.ai/sf-halloween-2026/skill.md)
ONE_API_KEY=""
ONE_MCP_URL=""
DISCORD_CHANNEL_ID="1564842098740695100"

# Scenario feed — the URL printed on your team card
SCENARIO_MCP="https://api.you.com/mcp/halloween-hack-26"

# Optional venue webhook fallback (only if One refuses after a retry; tell the organizers)
DISCORD_WEBHOOK_URL=""

# Set to 1 to run with zero keys / zero network
MOCK_PARTNERS=0
