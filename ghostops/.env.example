# Copy to ghostops/.env — never commit the real file.
TEAM_HANDLE="team-XX"

# You.com — grounding (X-API-Key header). Sign up at https://you.com/home
YDC_API_KEY=""

# Parasail — inference + embeddings (OpenAI-compatible at https://api.parasail.io/v1)
PARASAIL_API_KEY=""
PARASAIL_MODEL="parasail-glm-53-flash"
PARASAIL_EMBED_MODEL="parasail-bge-m3"

# One — real actions (Discord). Create key at app.withone.ai/settings/api-keys (sk_live_...).
# Dispatch runs One's LOCAL MCP server (`npx -y @withone/mcp`, needs Node 22+); the hosted
# https://mcp.withone.ai/mcp is browser-OAuth only and rejects API keys. Connect Discord first: `one add discord`.
ONE_API_KEY=""
DISCORD_CHANNEL_ID="1564842098740695100"

# Scenario feed — the URL printed on your team card
SCENARIO_MCP="https://api.you.com/mcp/halloween-hack-26"

# Venue webhook — organizers' recommended programmatic path while One's Discord send 401s (hack page §3.4).
# Dispatch order: One once → this webhook → loud "post manually". Set ONE_DISPATCH=0 to skip One entirely.
DISCORD_WEBHOOK_URL=""
ONE_DISPATCH=1

# Set to 1 to run with zero keys / zero network
MOCK_PARTNERS=0
